{
  "$schema": "https://raw.githubusercontent.com/martinring/tmlanguage/master/tmlanguage.json",
  "name": "Latch",
  "scopeName": "source.latch",
  "patterns": [
    { "include": "#comments" },
    { "include": "#strings" },
    { "include": "#numbers" },
    { "include": "#keywords" },
    { "include": "#types" },
    { "include": "#constants" },
    { "include": "#builtin-modules" },
    { "include": "#builtin-functions" },
    { "include": "#function-declarations" },
    { "include": "#function-calls" },
    { "include": "#operators" },
    { "include": "#punctuation" }
  ],
  "repository": {
    "comments": {
      "patterns": [
        {
          "name": "comment.line.number-sign.latch",
          "match": "#.*$"
        },
        {
          "name": "comment.line.double-slash.latch",
          "match": "//.*$"
        },
        {
          "name": "comment.block.latch",
          "begin": "/\\*",
          "end": "\\*/"
        }
      ]
    },
    "strings": {
      "patterns": [
        {
          "name": "string.quoted.double.latch",
          "begin": "\"",
          "end": "\"",
          "patterns": [
            {
              "name": "constant.character.escape.latch",
              "match": "\\\\([\"\\\\/bfnrt]|u[0-9a-fA-F]{4})"
            },
            {
              "name": "meta.embedded.line.latch",
              "begin": "\\$\\{",
              "end": "\\}",
              "beginCaptures": {
                "0": { "name": "punctuation.section.embedded.begin.latch" }
              },
              "endCaptures": {
                "0": { "name": "punctuation.section.embedded.end.latch" }
              },
              "patterns": [
                { "include": "source.latch" }
              ]
            }
          ]
        },
        {
          "name": "string.quoted.single.latch",
          "begin": "'",
          "end": "'",
          "patterns": [
            {
              "name": "constant.character.escape.latch",
              "match": "\\\\['\\\\/bfnrt]"
            }
          ]
        }
      ]
    },
    "numbers": {
      "patterns": [
        {
          "name": "constant.numeric.hex.latch",
          "match": "\\b0[xX][0-9a-fA-F_]+\\b"
        },
        {
          "name": "constant.numeric.binary.latch",
          "match": "\\b0[bB][01_]+\\b"
        },
        {
          "name": "constant.numeric.octal.latch",
          "match": "\\b0[oO][0-7_]+\\b"
        },
        {
          "name": "constant.numeric.float.latch",
          "match": "\\b[0-9][0-9_]*\\.[0-9][0-9_]*([eE][+-]?[0-9_]+)?\\b"
        },
        {
          "name": "constant.numeric.integer.latch",
          "match": "\\b[0-9][0-9_]*\\b"
        }
      ]
    },
    "keywords": {
      "patterns": [
        {
          "name": "keyword.control.latch",
          "match": "\\b(if|else|while|for|in|return|break|continue|try|catch|parallel|workers|import|from|export|let|const)\\b"
        },
        {
          "name": "keyword.operator.logical.latch",
          "match": "\\b(and|or|not)\\b"
        }
      ]
    },
    "types": {
      "patterns": [
        {
          "name": "storage.type.latch",
          "match": "\\b(int|float|string|bool|list|dict|void)\\b"
        }
      ]
    },
    "constants": {
      "patterns": [
        {
          "name": "constant.language.latch",
          "match": "\\b(true|false|null)\\b"
        }
      ]
    },
    "builtin-modules": {
      "patterns": [
        {
          "name": "support.class.latch",
          "match": "\\b(fs|proc|http|time|ai|json|env|path|math|regex|hash|set|csv|base64)\\b(?=\\.)"
        }
      ]
    },
    "builtin-functions": {
      "patterns": [
        {
          "name": "support.function.latch",
          "match": "\\b(print|len|str|int|float|typeof|push|pop|keys|values|range|sum|max|min|sort|filter|map|each|trim|upper|lower|split|starts_with|ends_with|contains|replace|assert|exit|dict_copy|list_copy|list_clear|index|count|reverse|popitem|get|fromkeys)\\b(?=\\()"
        }
      ]
    },
    "function-declarations": {
      "patterns": [
        {
          "match": "\\b(fn)\\s+([a-zA-Z_][a-zA-Z0-9_]*)",
          "captures": {
            "1": { "name": "keyword.declaration.function.latch" },
            "2": { "name": "entity.name.function.latch" }
          }
        },
        {
          "name": "keyword.declaration.function.latch",
          "match": "\\bfn\\b"
        }
      ]
    },
    "function-calls": {
      "patterns": [
        {
          "match": "\\b([a-zA-Z_][a-zA-Z0-9_]*)\\s*(?=\\()",
          "captures": {
            "1": { "name": "entity.name.function.latch" }
          }
        }
      ]
    },
    "operators": {
      "patterns": [
        {
          "name": "keyword.operator.assignment.latch",
          "match": ":=|\\+=|-=|\\*=|/=|%=|="
        },
        {
          "name": "keyword.operator.comparison.latch",
          "match": "==|!=|<=|>=|<|>"
        },
        {
          "name": "keyword.operator.special.latch",
          "match": "\\?\\?|\\?\\.|\\|>|\\.\\."
        },
        {
          "name": "keyword.operator.arithmetic.latch",
          "match": "\\+|-|\\*|/|%"
        }
      ]
    },
    "punctuation": {
      "patterns": [
        {
          "name": "punctuation.terminator.latch",
          "match": ";"
        },
        {
          "name": "punctuation.separator.latch",
          "match": ","
        },
        {
          "name": "punctuation.bracket.latch",
          "match": "[\\{\\}\\[\\]\\(\\)]"
        }
      ]
    }
  }
}
