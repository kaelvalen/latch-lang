# Tutorial 21: Environment & Time
# Access environment variables and timestamps.

print("=== Environment Module ===")
env_path := env.get("PATH") or "Not set"
print("PATH exists?: " + str(env_path != "Not set"))

print("\n=== Time Module ===")
now_ts := time.now()
print("Current UTC Timestamp: " + str(now_ts))

print("Sleeping for 10 milliseconds...")
time.sleep(10)
end_ts := time.now()
print("Sleep finished cleanly at: " + str(end_ts))

print("=== 06_stdlib/05_time_and_env.lt PASSED ===")
