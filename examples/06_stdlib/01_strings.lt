# Tutorial 17: String Utilities
# Common string operations from the standard library.

print("=== String Builtins ===")
text := "  Hello, Latch Language World!  "

trimmed := trim(text)
print("Trimmed text: '" + trimmed + "'")

upper_str := upper(trimmed)
print("To Upper: " + upper_str)

lower_str := lower(trimmed)
print("To Lower: " + lower_str)

words := split(trimmed, " ")
print("Split by space: " + str(words))

replaced := replace(trimmed, "World", "Developer")
print("Replaced 'World' -> 'Developer': " + replaced)

print("Contains 'Latch': " + str(contains(trimmed, "Latch")))
print("Starts with 'Hello': " + str(starts_with(trimmed, "Hello")))
print("Ends with '!': " + str(ends_with(trimmed, "!")))

print("Length: " + str(len(trimmed)))

print("=== 06_stdlib/01_strings.lt PASSED ===")
