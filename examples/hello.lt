# Latch Hello World — Feature Showcase

# 1. Variables and type annotations
name := "Latch"
version: int := 1
enabled: bool := true

# 2. String interpolation
print("Welcome to ${name} v${version}!")

# 3. Arithmetic operations
x := 10 + 5 * 2
print("10 + 5 * 2 = ${x}")

# 4. Control flow: if / else
if x > 15 {
    print("✓ x is greater than 15")
} else {
    print("• x is 15 or less")
}

# 5. Function definition
fn greet(who: string) -> string {
    return "Hello, ${who}!"
}

greeting := greet("Latch!")
print(greeting)

# 6. Lists and loops
languages := ["Rust", "Python", "Go"]
print("\nSupported languages:")
for lang in languages {
    print("  • ${lang}")
}

# 7. Dictionaries
config := {"port": 8080, "host": "localhost", "debug": true}
print("\nConfiguration:")
for key in keys(config) {
    print("  ${key}: ${config[key]}")
}

# 8. String operations
text := "  hello world  "
print("\nString operations:")
print("  Original: '${text}'")
print("  Trimmed: '${trim(text)}'")
print("  Uppercase: '${upper(trim(text))}'")

# 9. List operations
numbers := [3, 1, 4, 1, 5, 9]
print("\nList operations:")
print("  Original: ${numbers}")
sorted := sort(list_copy(numbers))
print("  Sorted: ${sorted}")
print("  Sum: ${sum(numbers)}")
print("  Max: ${max(numbers)}")

# 10. Filter and map (higher-order functions)
evens := filter(numbers, fn(n) { return n % 2 == 0 })
print("  Evens: ${evens}")
doubled := map([1, 2, 3], fn(n) { return n * 2 })
print("  Doubled: ${doubled}")

# 11. Error handling with try/catch
content := "file not found"
try {
    content = fs.read("example.txt")
} catch e {
    content = "file not found"
}
print("\nFile read result: ${content}")

# 12. Try / catch for more control
try {
    result := http.get("https://api.github.com")
    print("HTTP Status: ${result.status}")
} catch e {
    print("Error: ${e}")
}

# 13. Parallel
files := ["a.txt", "b.txt", "c.txt"]
parallel f in files workers=2 {
    fs.write(f, "parallel yazıldı: ${f}")
}
print("Parallel yazma tamamlandı!")

# Temizlik
proc.exec("rm -f test_output.txt a.txt b.txt c.txt")
print("\n✓ Feature showcase complete!")
