# Tutorial 04: String Interpolation
# Embed expressions directly inside strings with ${...}.

print("=== String Interpolation ===")

name := "Latch"
version := 0.5

print("Welcome to ${name} v${version}!")

a := 10
b := 20
print("${a} + ${b} = ${a + b}")

items := ["milk", "eggs", "bread"]
print("Shopping list has ${len(items)} items: ${items}")

