# 03_stdlib/system_and_time.lt
# Latch Language - Standard Library: env & time modules

print("=== 1. Environment Module (env.*) ===")
env_path := env.get("PATH") or "Not set"
print("Environment variable PATH exists?: " + str(env_path != "Not set"))

print("\n=== 2. Time Module (time.*) ===")
now_ts := time.now()
print("Current UTC Timestamp: " + str(now_ts))

print("Sleeping for 10 milliseconds...")
time.sleep(10)
end_ts := time.now()
print("Sleep finished cleanly at: " + str(end_ts))

print("\n=== 03_stdlib/system_and_time.lt PASSED ===")
