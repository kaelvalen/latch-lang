# 02_functions_and_closures/functions.lt
# Latch Language - Named Functions, Recursion & Pipelines

print("=== 1. Basic Named Functions ===")
fn add(a, b) {
    return a + b
}

fn multiply(a, b) {
    return a * b
}

print("add(15, 27) = " + str(add(15, 27)))
print("multiply(6, 7) = " + str(multiply(6, 7)))

print("\n=== 2. Recursive Functions (Factorial & Fibonacci) ===")
fn factorial(n) {
    if n <= 1 {
        return 1
    } else {
        return n * factorial(n - 1)
    }
}

fn fibonacci(n) {
    if n <= 0 {
        return 0
    } elif n == 1 {
        return 1
    } else {
        return fibonacci(n - 1) + fibonacci(n - 2)
    }
}

print("factorial(6) = " + str(factorial(6)))
print("fibonacci(8) = " + str(fibonacci(8)))

print("\n=== 3. Functions Returning Structured Objects ===")
fn create_user(username, email, role) {
    return {
        "username": username,
        "email": email,
        "role": role,
        "is_active": true
    }
}

u1 := create_user("kael", "kael@latch.lang", "admin")
print("User Created: " + u1["username"] + " (Role: " + u1["role"] + ")")

print("\n=== 4. Helper Function Pipeline ===")
fn square(x) { return x * x }
fn double(x) { return x * 2 }

fn process_number(n) {
    return square(double(n))
}

print("process_number(5) -> square(double(5)) = " + str(process_number(5)))

print("\n=== 02_functions_and_closures/functions.lt PASSED ===")
