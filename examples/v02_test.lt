# file-operations.lt — File System Manipulation Example
#
# Demonstrates:
#   • Reading and writing files
#   • Directory operations
#   • Glob pattern matching
#   • File metadata and checking
#   • Text processing and filtering
#
# Usage:
#   latch run examples/v02_test.lt

print("File System Operations Example\n")

# 1. Create sample files and directories
print("→ Setting up test environment...")
fs.mkdir("test_output")
fs.write("test_output/sample1.txt", "Hello from Latch")
fs.write("test_output/sample2.txt", "Line 1\nLine 2\nLine 3")
fs.write("test_output/data.json", "{\"name\": \"test\", \"value\": 42}")
print("✓ Created test files\n")

# 2. Read and process files
print("→ Reading and processing files...")
content1 := fs.read("test_output/sample1.txt")
print("File 1: ${content1}")

content2 := fs.read("test_output/sample2.txt")
lines := split(content2, "\n")
print("File 2 has ${len(lines)} lines")
for line in lines {
    print("  • ${line}")
}
print()

# 3. JSON operations
print("→ JSON file operations...")
json_content := fs.read("test_output/data.json")
data := json.parse(json_content)
print("Parsed JSON: name='${data.name}', value=${data.value}")
print()

# 4. Glob patterns
print("→ Finding files with glob patterns...")
all_files := fs.glob("test_output/*")
print("Files in test_output:")
for file in all_files {
    print("  • ${file}")
}
print()

# 5. File existence checks
print("→ Checking file metadata...")
for file in ["test_output/sample1.txt", "test_output/missing.txt"] {
    if fs.exists(file) {
        print("✓ ${file} exists")
    } else {
        print("✗ ${file} not found")
    }
}
print()

# 6. String operations (modulo, upper/lower)
print("→ String transformations...")
text := "LaTcH lAnGuAgE"
print("Original: ${text}")
print("Lowercase: ${lower(text)}")
print("Uppercase: ${upper(text)}")
print()

# 7. Numeric operations (modulo)
print("→ Math operations...")
numbers := [10, 17, 20, 13]
for num in numbers {
    remainder := num % 3
    print("${num} mod 3 = ${remainder}")
}
print()

# 8. Higher-order functions
print("→ Using map/filter...")
values := [1, 2, 3, 4, 5]
doubled := map(values, fn(x) { return x * 2 })
print("Doubled: ${doubled}")

evens := filter(values, fn(x) { return x % 2 == 0 })
print("Even numbers: ${evens}")
print()

# 9. String checks
print("→ String predicates...")
greeting := "Hello World"
print("Starts with 'Hello': ${starts_with(greeting, 'Hello')}")
print("Ends with 'World': ${ends_with(greeting, 'World')}")
print("Contains 'World': ${contains(greeting, 'World')}")
print()

# 10. Null coalesce operator
print("→ Null coalesce ??...")
maybe_value := null
result1 := maybe_value ?? "default value"
print("null ?? 'default': ${result1}")

real_value := "actual value"
result2 := real_value ?? "default"
print("'actual' ?? 'default': ${result2}")

# 11. Type checking
print("→ Type information...")
test_values := [42, 3.14, "text", true, null, [1, 2], {"k": "v"}]
for val in test_values {
    t := typeof(val)
    print("typeof(${val}): ${t}")
}
print()

# Cleanup
print("→ Cleanup...")
result := proc.exec("rm -rf test_output")
print("✓ Cleanup complete\n")

print("✓ All file operations tested!")

// ═══ 8. IN operator ═══
print("--- in operator ---")
items := ["apple", "banana", "cherry"]
print("banana" in items)
print("grape" in items)
print("lo" in "Hello World")
cfg := {"host": "127.0.0.1", "port": 8080}
print("host" in cfg)
print("missing" in cfg)

// ═══ 9. RANGE .. operator ═══
print("--- range ---")
r2 := 1..5
print(r2)
print(len(r2))

// ═══ 10. PIPE |> operator ═══
print("--- pipe ---")
result := [3, 1, 4, 1, 5] |> sort()
print(result)
result2 := [10, 20, 30, 40] |> filter(fn(x) { return x > 15 })
print(result2)

// ═══ 11. COMPOUND ASSIGNMENTS ═══
print("--- compound assign ---")
count := 10
count += 5
print(count)
count -= 3
print(count)
count *= 2
print(count)
count /= 4
print(count)
count %= 5
print(count)

// ═══ 12. SAFE ACCESS ?. ═══
print("--- safe access ---")
val := null
print(val?.name)
m := {"host": "localhost"}
print(m?.host)
print(m?.missing)

// ═══ 13. keys/values on dict ═══
print("--- keys/values ---")
print(keys(d))
print(values(d))

// ═══ 14. filter + map combo ═══
print("--- combos ---")
big := filter(nums, fn(x) { return x > 2 })
print(big)
evens := filter(nums, fn(x) { return x % 2 == 0 })
print(evens)

print("=== ALL TESTS PASSED ===")
