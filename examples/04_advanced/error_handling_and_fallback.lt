# 04_advanced/error_handling_and_fallback.lt
# Latch Language - Error Handling (try/catch/finally) & 'or' Fallback Operator

print("=== 1. Try / Catch / Finally Exception Handling ===")

finally_ran := false

try {
    print("Inside try block: attempting invalid division or operation...")
    res := 100 / 0
    print("This will not be reached: " + str(res))
} catch err {
    print("Caught Exception successfully -> " + str(err))
} finally {
    finally_ran = true
    print("Finally block executed cleanly!")
}

print("Finally execution confirmed: " + str(finally_ran))

print("\n=== 2. Short-Circuiting 'or' Fallback Operator ===")

# Example A: Safe JSON Parse Fallback
invalid_json := "{name: broken_json_without_quotes"
parsed := json.parse(invalid_json) or {"status": "fallback_default", "code": 500}
print("Parsed invalid JSON with fallback: " + str(parsed["status"]))

# Example B: Fallback when value is null or falsy
user_input := null
display_name := user_input or "Guest_User"
print("Resolved display name: " + display_name)

# Example C: Short-circuiting evaluation
evaluated_second := false
fn side_effect() {
    evaluated_second = true
    return "Second Value"
}

first_val := "First Valid Value"
final_res := first_val or side_effect()
print("First val truthy: " + final_res)
print("Was second side-effect evaluated?: " + str(evaluated_second))

print("\n=== 04_advanced/error_handling_and_fallback.lt PASSED ===")
